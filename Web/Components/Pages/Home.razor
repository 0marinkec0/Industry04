@page "/"

<PageTitle>IoT 4.0 - Smart Industrial Monitoring</PageTitle>

<div class="home-page">

    <!-- Navigation -->


    <!-- Hero -->
    <section class="hero-section">

        <div class="container">

            <div class="row align-items-center min-vh-75">

                <div class="col-lg-6">

                    <div class="badge bg-info-subtle text-info mb-3 px-3 py-2">
                        INDUSTRIAL IoT PLATFORM
                    </div>

                    <h1 class="display-3 fw-bold text-white">
                        Smart Industry.
                        <span class="text-info">Connected.</span>
                    </h1>

                    <p class="lead text-secondary mt-4">
                        Monitor your industrial devices, collect real-time
                        sensor data and gain valuable insights into your
                        production environment.
                    </p>

                    <div class="mt-4 d-flex gap-3 flex-wrap">

                        <a href="/register"
                           class="btn btn-info btn-lg px-4">
                            Get Started
                        </a>

                        <a href="/login"
                           class="btn btn-outline-light btn-lg px-4">
                            Sign In
                        </a>

                    </div>

                    <div class="mt-5 text-secondary small">
                        <span class="text-success">●</span>
                        Real-time monitoring
                        <span class="mx-3">•</span>
                        Secure
                        <span class="mx-3">•</span>
                        Scalable
                    </div>

                </div>


                <!-- Hero Dashboard Preview -->
                <div class="col-lg-6 mt-5 mt-lg-0">

                    <div class="dashboard-preview shadow-lg">

                        <div class="preview-header">
                            <span>IoT Dashboard</span>

                            <span class="badge bg-success">
                                System Online
                            </span>
                        </div>

                        <div class="row g-3 mt-2">

                            <div class="col-6">
                                <div class="mini-card">
                                    <small>Devices</small>
                                    <h3>128</h3>
                                    <span class="text-success">
                                        ↑ 12%
                                    </span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="mini-card">
                                    <small>Online</small>
                                    <h3>116</h3>
                                    <span class="text-success">
                                        90.6%
                                    </span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="mini-card">

                                    <div class="d-flex justify-content-between">
                                        <span>Temperature</span>
                                        <strong>72.4 °C</strong>
                                    </div>

                                    <div class="fake-chart mt-3">
                                        <div class="chart-line"></div>
                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- Features -->
    <section id="features" class="features-section py-5">

        <div class="container">

            <div class="text-center mb-5">

                <span class="text-info fw-semibold">
                    POWERFUL FEATURES
                </span>

                <h2 class="fw-bold mt-2">
                    Everything you need to manage your IoT environment
                </h2>

                <p class="text-secondary">
                    One platform for monitoring, analytics and device management.
                </p>

            </div>


            <div class="row g-4">

                <div class="col-md-6 col-lg-3">

                    <div class="feature-card h-100">

                        <div class="feature-icon">
                            📡
                        </div>

                        <h5>Real-time Monitoring</h5>

                        <p class="text-secondary">
                            Monitor sensors and industrial equipment
                            in real time.
                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="feature-card h-100">

                        <div class="feature-icon">
                            ⚙️
                        </div>

                        <h5>Device Management</h5>

                        <p class="text-secondary">
                            Manage connected devices, sensors and
                            industrial machines.
                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="feature-card h-100">

                        <div class="feature-icon">
                            📊
                        </div>

                        <h5>Analytics</h5>

                        <p class="text-secondary">
                            Turn sensor data into useful production
                            insights.
                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="feature-card h-100">

                        <div class="feature-icon">
                            🚨
                        </div>

                        <h5>Alerts</h5>

                        <p class="text-secondary">
                            Detect abnormal conditions and receive
                            instant notifications.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- How it works -->
    <section id="about" class="how-section py-5">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-6">

                    <span class="text-info fw-semibold">
                        HOW IT WORKS
                    </span>

                    <h2 class="fw-bold mt-2 mb-4">
                        From device to insight
                    </h2>

                    <p class="text-secondary">
                        Connect your industrial devices, collect sensor
                        data and monitor your entire environment from
                        one centralized platform.
                    </p>

                    <div class="steps mt-4">

                        <div class="step">
                            <div class="step-number">1</div>
                            <div>
                                <h5>Connect</h5>
                                <p class="text-secondary">
                                    Connect your IoT devices and sensors.
                                </p>
                            </div>
                        </div>

                        <div class="step">
                            <div class="step-number">2</div>
                            <div>
                                <h5>Monitor</h5>
                                <p class="text-secondary">
                                    Monitor your equipment in real time.
                                </p>
                            </div>
                        </div>

                        <div class="step">
                            <div class="step-number">3</div>
                            <div>
                                <h5>Analyze</h5>
                                <p class="text-secondary">
                                    Analyze collected data and improve
                                    your production.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>


                <div class="col-lg-6 mt-5 mt-lg-0">

                    <div class="info-panel">

                        <div class="d-flex justify-content-between mb-4">
                            <span>System Status</span>
                            <span class="text-success">
                                ● Operational
                            </span>
                        </div>

                        <hr>

                        <div class="row text-center">

                            <div class="col-4">
                                <h3>128</h3>
                                <small class="text-secondary">
                                    Devices
                                </small>
                            </div>

                            <div class="col-4">
                                <h3>99.8%</h3>
                                <small class="text-secondary">
                                    Uptime
                                </small>
                            </div>

                            <div class="col-4">
                                <h3>24/7</h3>
                                <small class="text-secondary">
                                    Monitoring
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="cta-section py-5">

        <div class="container text-center">

            <h2 class="fw-bold text-white">
                Ready to connect your industry?
            </h2>

            <p class="text-secondary mb-4">
                Create your account and start monitoring your IoT environment.
            </p>

            <a href="/register"
               class="btn btn-info btn-lg px-5">
                Create Account
            </a>

        </div>

    </section>


    <!-- Footer -->
    <footer class="bg-dark text-secondary py-4">

        <div class="container">

            <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-3">

                <div>
                    <strong class="text-white">
                        IoT 4.0
                    </strong>

                    <div class="small">
                        Industrial IoT Platform
                    </div>
                </div>

                <div class="small">
                    © 2026 IoT 4.0. All rights reserved.
                </div>
            </div>
        </div>
    </footer>
</div>