@page "/statistics"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Routing
@using Shared.Respons
@using Shared.Respons.Sensor
@using Web.Common.Exceptions
@using Web.Components.Helper
@using Web.Services
@inject NavigationManager _navigationManager
@inject ApiService _apiService
@inject Blazored.LocalStorage.ILocalStorageService _localStorageService
@attribute [Authorize]


<PageTitle>Statistic</PageTitle>

<div class="container py-4">
<h2 class="mb-4">Sensor Statistics</h2>
    <div class="row g-4 justify-content-center">

@foreach (var statisticsReading in statisticsReadings)
{
    <div class="container-fluid py-4">
        <div class="row g-4">

            <!-- SENSOR 1 -->
            <div class="col-12 col-xl-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-thermometer-half me-2"></i>
                                    @statisticsReading.SensorType @GetUnitHelper.GetUnit(statisticsReading.SensorType!)
                        </h5>
                    </div>

                    <div class="card-body">
                        <div class="row text-center">
                            <!-- MIN -->
                            <div class="col-4">
                                <div class="text-muted small">
                                    MINIMUM
                                </div>
                                <div class="fs-3 fw-bold">
                                   @statisticsReading.Minimal
                                </div>
                            </div>

                            <!-- AVERAGE -->
                            <div class="col-4 border-start border-end">
                                <div class="text-muted small">
                                   AVERAGE
                                </div>

                                <div class="fs-3 fw-bold">
                                    @statisticsReading.Average
                                </div>
                            </div>

                            <!-- MAX -->
                            <div class="col-4">
                                <div class="text-muted small">
                                    MAXIMUM
                                </div>

                                <div class="fs-3 fw-bold">
                                    @statisticsReading.Maximal
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
    </div>
</div>


@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger col-8 col-md-6 col-lg-5 col-xl-4 mx-auto mb-3" role="alert">
        @error
    </div>
} 

@code {

    private List<StatisticReading> statisticsReadings = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            statisticsReadings = await _apiService.Get<List<StatisticReading>>("/sensor/get-sensor-statistic");
        }
        catch (UnauthorizedException ex)
        {
            _navigationManager.NavigateTo("/login");
        }
    }
}
