@page "/confirm-email"
@using Microsoft.AspNetCore.WebUtilities
@using Shared.Requests
@using Shared.Requests.Auth
@using Web.Services
@inject NavigationManager _navigationManager
@inject ApiService _apiService

@if (isConfirmationSuccessful)
{
    <h3>Email confirmation was successful. <a class="link" href="login">Login</a></h3>
}

@if (!isConfirmationSuccessful)
{
    <h3>Treba resend email tokena napraviti</h3>
}

@code {
    private ConfirmEmailRequest confirmEmailRequest = new();
    private bool isConfirmationSuccessful = false;

    protected override async Task OnInitializedAsync()
    {
        ParseQueryString();

        try
        {
            await _apiService.Post<ConfirmEmailRequest>("/auth/confirm-email", confirmEmailRequest);
            isConfirmationSuccessful = true;
        }
        catch
        {
            isConfirmationSuccessful = false;
        }
    }

    private void ParseQueryString()
    {
        var uri = _navigationManager.ToAbsoluteUri(_navigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("email", out var email))
        {
            confirmEmailRequest.Email = email!;
        }

        if (query.TryGetValue("token", out var token))
        {
            confirmEmailRequest.Token = token!;
        }
    }

}